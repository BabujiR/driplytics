# Copy to .env and adjust. Docker Compose reads .env from the repo root automatically.
# Every value has a working local default in compose.yaml, so .env is optional for local dev.

# --- Postgres ---
POSTGRES_USER=driplytics
POSTGRES_PASSWORD=driplytics-dev
POSTGRES_DB=driplytics
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage; GCS/S3 in the cloud, ADR 0007) ---
MINIO_ROOT_USER=driplytics
MINIO_ROOT_PASSWORD=driplytics-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_RAW_BUCKET=driplytics-raw
STORAGE_DATA_BUCKET=driplytics-data

# --- Keycloak (local OIDC provider, ADR 0004) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_PORT=8080

# --- Mailpit (local email inbox) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- App ports ---
API_PORT=8000
WEB_PORT=3000

# --- App settings (read by apps/api and services/worker, prefix DRIPLYTICS_) ---
DRIPLYTICS_ENV=local
DRIPLYTICS_LOG_LEVEL=INFO
